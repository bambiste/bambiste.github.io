# Default registry for public packages
registry=https://registry.npmjs.org/

# @fluixi scoped packages → GitHub Packages (github.com/fluixi org)
# Auth token lives in ~/.npmrc (local) or NODE_AUTH_TOKEN (CI / Cloudflare build).
@fluixi:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
